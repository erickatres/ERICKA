<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="10dp">



    <TextView
        android:id="@+id/tvReviewerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reviewer Name"
        android:layout_marginStart="43dp"
        android:textSize="16sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatRatingBar
        android:id="@+id/reviewRatingBar"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="start"
        android:isIndicator="true"
        android:numStars="5"
        android:scaleX="0.7"
        android:scaleY="0.6"
        android:stepSize="0.5"
        android:layout_marginEnd="150dp"
        android:progressTint="@color/starcolor"
        android:theme="@style/Widget.AppCompat.RatingBar.Small" />

    <TextView
        android:id="@+id/tvReviewText"
        android:layout_marginStart="43dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Review text goes here..."
        android:textSize="14sp" />

</LinearLayout>
