<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".Fragments.PricelistFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="87dp"
                android:background="@drawable/rectanglebg"
                android:paddingTop="45dp"
                android:text="Services"
                android:textAlignment="textStart"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Regular Plain -->
            <LinearLayout
                android:id="@+id/regular_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/regularplain" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:gravity="start"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:text="Regular Plain"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="₱200"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gel Polish -->
            <LinearLayout
                android:id="@+id/gel_polish_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/gel_polish" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/gel_polish_text"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:gravity="center_vertical"
                        android:text="Gel Polish"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="₱300"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>


            <!-- Short Soft Gel Extension -->
            <LinearLayout
                android:id="@+id/short_soft_gel_extension_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/shortsoftgelextension" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/short_soft_gel_extension"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="Short Soft Gel Extension"
                        android:textColor="@color/black"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="₱500"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Medium Soft Gel Extension -->
            <LinearLayout
                android:id="@+id/medium_soft_gel_extension_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/medium_soft_gel_extension" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/medium_soft_gel_extension"
                        android:layout_width="250dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:text="Medium Soft Gel Extension"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="₱700"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Long Soft Gel Extension -->
            <LinearLayout
                android:id="@+id/long_soft_gel_extension_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:padding="20dp">


                <ImageView
                    android:id="@+id/imageView5"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/long_soft_gel_extension" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/long_soft_gel_extension"
                        android:layout_width="230dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:text="Long Soft Gel Extension"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="₱900"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/removal_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bottom_boarder"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="104dp"
                    android:layout_height="106dp"
                    android:src="@drawable/removal" />

                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_height="99dp"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:gravity="start">

                    <TextView
                        android:id="@+id/removaltext"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:text="Removal"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:clickable="true"
                        android:focusable="true"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/price_text6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="₱150"
                        android:layout_marginStart="10dp"
                        android:textColor="@color/black"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>