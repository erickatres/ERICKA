<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:textColor="#2A677C"
                android:textSize="36sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvServiceDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Service Details"
                android:textColor="#2F7889"
                android:textSize="18sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/summary_service"
                    style="@style/LabelStyle"
                    android:text="Service" />

                <TextView
                    android:id="@+id/tvService"
                    style="@style/ValueStyle" />

                <TextView
                    android:id="@+id/summary_color"
                    style="@style/LabelStyle"
                    android:text="Color" />

                <TextView
                    android:id="@+id/tvShape"
                    style="@style/ValueStyle" />

                <TextView
                    android:id="@+id/summary_date"
                    style="@style/LabelStyle"
                    android:text="Date" />

                <TextView
                    android:id="@+id/tvLength"
                    style="@style/ValueStyle" />

                <TextView
                    android:id="@+id/summary_time"
                    style="@style/LabelStyle"
                    android:text="Time" />

                <TextView
                    android:id="@+id/tvColor"
                    style="@style/ValueStyle" />

                <TextView
                    android:id="@+id/summary_mobile_number"
                    style="@style/LabelStyle"
                    android:text="Mobile no." />

                <TextView
                    android:id="@+id/tvAddOns"
                    style="@style/ValueStyle" />

                <TextView
                    android:id="@+id/tvDate"
                    style="@style/ValueStyle" />
            </LinearLayout>

            <!-- Price Details -->
            <TextView
                android:id="@+id/tvPriceDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Price details"
                android:textColor="#2A677C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/LabelStyle"
                    android:text="Regular Plain" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#BDBDBD" />


                <TextView
                    android:id="@+id/textView14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="240dp"
                    android:layout_marginTop="50dp"
                    android:text="TextView" />




                <TextView
                    android:id="@+id/summary_total"
                    style="@style/LabelStyle"
                    android:text="Total"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:id="@+id/tvAddOnsPrice"
                    style="@style/ValueStyle" />

                <TextView
                    style="@style/LabelBold"
                    android:text="Total" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    style="@style/ValueBold" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <Button
            android:id="@+id/noaddons"
            android:layout_width="175dp"
            android:layout_height="70dp"
            android:textSize="16dp"
            android:text="Cancel"
            android:textColor="@color/grey"
            android:background="@drawable/cancel_button"
            android:enabled="false" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="175dp"
            android:layout_height="75dp"
            android:layout_marginStart="16dp"
            android:text="Confirm"
            android:backgroundTint="@color/confirm"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:enabled="false"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>