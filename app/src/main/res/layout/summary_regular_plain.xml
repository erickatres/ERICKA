<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Summary"
                android:layout_marginTop="30dp"
                android:textColor="#2A677C"
                android:textSize="36sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvServiceDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Service Details"
                android:textColor="#2F7889"
                android:textSize="18sp"
                android:textStyle="normal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:text="Service" />

                    <TextView
                        android:id="@+id/tvService"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Regular Plain" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:textColor="@color/black"
                        android:layout_weight="1"
                        android:text="Date" />

                    <TextView
                        android:id="@+id/tvdate"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="March 8, 2025" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:text="Time" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="9:00 AM" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/details_shape"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Shape"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvShape"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Almond" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/details_length"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="15dp"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:text="Length" />

                    <TextView
                        android:id="@+id/tvLength"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="long" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Mobile no."
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tvMobile"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="09875142367" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPhotoReference"
                    style="@style/ValueStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Photo Reference:"
                    android:textSize="18sp"/>

                <ImageView
                    android:id="@+id/imgPhotoReference"
                    android:layout_width="76dp"
                    android:layout_height="75dp"
                    android:layout_marginTop="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/photoreference" />
            </LinearLayout>

            <!-- Price Details -->
            <TextView
                android:id="@+id/tvPriceDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Price details"
                android:textColor="#2A677C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingTop="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/tv_service_details"
                        style="@style/LabelStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:textColor="@color/black"
                        android:text="Regular Plain" />

                    <TextView
                        android:id="@+id/tvservicePrice"
                        style="@style/ValueStyle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="₱450" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#BDBDBD" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/LabelBold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <TextView
                        android:id="@+id/total_price"
                        style="@style/ValueStyle"
                        android:layout_width="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:layout_marginBottom="12dp"
                        android:text="₱350" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="0dp">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="178dp"
            android:layout_height="68dp"
            android:padding="18dp"
            android:textAlignment="center"
            android:text="Cancel"
            android:textSize="20sp"
            android:textColor="@color/grey"
            android:background="@drawable/btn_cancel"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/btnConfirm"
            android:layout_width="178dp"
            android:layout_height="68dp"
            android:padding="18dp"
            android:textAlignment="center"
            android:text="Confirm"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/white"
            android:background="@drawable/button_confirm"
            android:layout_marginEnd="10dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>