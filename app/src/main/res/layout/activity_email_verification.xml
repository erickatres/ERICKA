<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <FrameLayout
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/whitecircle"
        android:elevation="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:src="@drawable/back_arrorw" />
    </FrameLayout>


    <TextView
        android:id="@+id/tvEmailVerification"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Email Verification"
        android:textColor="#2F7889"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvEnterEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Code"
        android:textColor="#2F7889"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.166"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEmailVerification"
        app:layout_constraintVertical_bias="0.253" />

    <TextView
        android:id="@+id/tvEmailDescription"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:text="Enter the 4 digit code we sent to
your email address."
        android:textColor="#000000"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.343"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvEnterEmail"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/otpContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvEmailDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etOtp1"
            android:layout_width="65dp"
            android:layout_height="80dp"
            android:background="@drawable/otp_box"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"
            android:importantForAccessibility="yes"
            android:focusableInTouchMode="true" />

        <EditText
            android:id="@+id/etOtp2"
            android:layout_width="65dp"
            android:layout_height="80dp"
            android:background="@drawable/otp_box"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"
            android:importantForAccessibility="yes"
            android:focusableInTouchMode="true"
            android:layout_marginStart="12dp" />

        <EditText
            android:id="@+id/etOtp3"
            android:layout_width="65dp"
            android:layout_height="80dp"
            android:background="@drawable/otp_box"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"
            android:importantForAccessibility="yes"
            android:focusableInTouchMode="true"
            android:layout_marginStart="12dp" />

        <EditText
            android:id="@+id/etOtp4"
            android:layout_width="65dp"
            android:layout_height="80dp"
            android:background="@drawable/otp_box"
            android:gravity="center"
            android:inputType="number"
            android:maxLength="1"
            android:textSize="20sp"
            android:textColor="#000000"
            android:importantForAccessibility="yes"
            android:focusableInTouchMode="true"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- Resend Code Container -->
    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/otpContainer">

        <!-- Didn't Receive Code Text -->
        <TextView
            android:id="@+id/tvDidntReceiveCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn’t receive code?"
            android:textColor="#2F7889"
            android:textSize="14sp" />

        <!-- Resend Text -->
        <TextView
            android:id="@+id/tvResendCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="4dp"
            android:text=" Resend"
            android:textColor="#2F7889"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>


    <TextView
        android:id="@+id/btnOkay"
        android:layout_width="335dp"
        android:layout_height="70dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/button_done_review"
        android:gravity="center"
        android:text="Verify"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>